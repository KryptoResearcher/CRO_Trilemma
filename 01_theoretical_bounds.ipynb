    "    axes[idx].legend()\n",
    "\n",
    "plt.suptitle('Quantum Channel Effects on Interpretability', fontsize=14)\n",
    "plt.tight_layout()\n",
    "plt.show()\n",
    "\n",
    "# Show effect on trilemma bound\n",
    "context_entropy = 10\n",
    "quantum_losses = np.linspace(0, 0.1, 50)\n",
    "bounds_with_quantum = [theoretical_bound(context_entropy, eta_q) for eta_q in quantum_losses]\n",
    "\n",
    "plt.figure(figsize=(10, 6))\n",
    "plt.plot(quantum_losses, bounds_with_quantum, 'b-', linewidth=2)\n",
    "plt.xlabel('Quantum Interpretability Loss η_q', fontsize=12)\n",
    "plt.ylabel('CRO Bound', fontsize=12)\n",
    "plt.title('Effect of Quantum Loss on Trilemma Bound', fontsize=14)\n",
    "plt.grid(True, alpha=0.3)\n",
    "plt.axhline(y=theoretical_bound(context_entropy, 0), \n",
    "           color='r', linestyle='--', alpha=0.5, \n",
    "           label='Classical bound (η_q=0)')\n",
    "plt.legend()\n",
    "plt.tight_layout()\n",
    "plt.show()\n",
    "\n",
    "print(f\"Classical bound: {theoretical_bound(context_entropy, 0):.6f}\")\n",
    "print(f\"With η_q=0.01: {theoretical_bound(context_entropy, 0.01):.6f}\")\n",
    "print(f\"Relative increase: {(theoretical_bound(context_entropy, 0.01)/theoretical_bound(context_entropy, 0) - 1)*100:.2f}%\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 6. Optimal Protocol Design\n",
    "\n",
    "Given requirements, find the optimal CRO trade-off point."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 7,
   "metadata": {},
   "outputs": [],
   "source": [
    "def optimize_protocol(requirements, context_entropy=10):\n",
    "    \"\"\"\n",
    "    Find optimal protocol parameters given requirements\n",
    "    requirements: dict with min values for each dimension\n",
    "    \"\"\"\n",
    "    bound = theoretical_bound(context_entropy)\n",
    "    \n",
    "    # Define objective function (minimize deviation from requirements)\n",
    "    def objective(x):\n",
    "        priv, rel, opp = x\n",
    "        \n",
    "        # Check trilemma constraint\n",
    "        if priv * rel * opp > bound:\n",
    "            return 1e10  # Infeasible\n",
    "        \n",
    "        # Calculate weighted deviation from requirements\n",
    "        dev_priv = max(0, requirements.get('min_priv', 0) - priv)\n",
    "        dev_rel = max(0, requirements.get('min_rel', 0) - rel)\n",
    "        dev_opp = max(0, requirements.get('min_opp', 0) - opp)\n",
    "        \n",
    "        return dev_priv**2 + dev_rel**2 + dev_opp**2\n",
    "    \n",
    "    # Constraints\n",
    "    constraints = [\n",
    "        {'type': 'ineq', 'fun': lambda x: bound - x[0]*x[1]*x[2]},  # Trilemma\n",
    "        {'type': 'ineq', 'fun': lambda x: x[0]},  # priv >= 0\n",
    "        {'type': 'ineq', 'fun': lambda x: x[1]},  # rel >= 0\n",
    "        {'type': 'ineq', 'fun': lambda x: x[2]},  # opp >= 0\n",
    "        {'type': 'ineq', 'fun': lambda x: 1 - x[0]},  # priv <= 1\n",
    "        {'type': 'ineq', 'fun': lambda x: 1 - x[1]},  # rel <= 1\n",
    "        {'type': 'ineq', 'fun': lambda x: 1 - x[2]},  # opp <= 1\n",
    "    ]\n",
    "    \n",
    "    # Initial guess\n",
    "    x0 = [0.5, 0.5, 0.5]\n",
    "    \n",
    "    # Optimize\n",
    "    result = optimize.minimize(objective, x0, method='SLSQP', \n",
    "                              constraints=constraints)\n",
    "    \n",
    "    if result.success:\n",
    "        priv_opt, rel_opt, opp_opt = result.x\n",
    "        return {\n",
    "            'confidentiality': priv_opt,\n",
    "            'reliability': rel_opt,\n",
    "            'opposability': opp_opt,\n",
    "            'product': priv_opt * rel_opt * opp_opt,\n",
    "            'gamma_cro': 1 - min(priv_opt, rel_opt, opp_opt),\n",
    "            'feasible': True\n",
    "        }\n",
    "    else:\n",
    "        return {'feasible': False, 'message': 'No feasible solution found'}\n",
    "\n",
    "# Test different requirement scenarios\n",
    "scenarios = [\n",
    "    {'name': 'High Security', 'min_priv': 0.9, 'min_rel': 0.9, 'min_opp': 0.0},\n",
    "    {'name': 'Balanced', 'min_priv': 0.5, 'min_rel': 0.5, 'min_opp': 0.5},\n",
    "    {'name': 'Legal Focus', 'min_priv': 0.0, 'min_rel': 0.9, 'min_opp': 0.8},\n",
    "    {'name': 'Impossible', 'min_priv': 0.9, 'min_rel': 0.9, 'min_opp': 0.9},\n",
    "]\n",
    "\n",
    "results = []\n",
    "for scenario in scenarios:\n",
    "    name = scenario.pop('name')\n",
    "    result = optimize_protocol(scenario, context_entropy=10)\n",
    "    result['scenario'] = name\n",
    "    results.append(result)\n",
    "\n",
    "# Display results\n",
    "df_results = pd.DataFrame(results)\n",
    "display(df_results[['scenario', 'feasible', 'confidentiality', 'reliability', \n",
    "                    'opposability', 'gamma_cro']].round(4))\n",
    "\n",
    "# Visualize feasible solutions\n",
    "fig = plt.figure(figsize=(10, 8))\n",
    "ax = fig.add_subplot(111, projection='3d')\n",
    "\n",
    "for _, row in df_results[df_results['feasible']].iterrows():\n",
    "    ax.scatter([row['confidentiality']], \n",
    "              [row['reliability']], \n",
    "              [row['opposability']],\n",
    "              s=100, label=row['scenario'])\n",
    "\n",
    "ax.set_xlabel('Confidentiality')\n",
    "ax.set_ylabel('Reliability')\n",
    "ax.set_zlabel('Opposability')\n",
    "ax.set_title('Optimal Protocol Configurations')\n",
    "ax.legend()\n",
    "ax.view_init(elev=20, azim=45)\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 7. Asymptotic Behavior\n",
    "\n",
    "Analyze what happens as the security parameter λ → ∞"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 8,
