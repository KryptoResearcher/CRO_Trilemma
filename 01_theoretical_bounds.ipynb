   "# Context entropy grows with λ\n",
   "context_entropies_lambda = lambdas * 0.5  # H(C) = Θ(λ)\n",
   "\n",
   "# Calculate bounds for different growth rates\n",
   "bounds_linear = [theoretical_bound(h_c, security_param=lam) \n",
   "                 for h_c, lam in zip(context_entropies_lambda, lambdas)]\n",
   "bounds_log = [theoretical_bound(np.log2(lam), security_param=lam) \n",
   "              for lam in lambdas]\n",
   "bounds_const = [theoretical_bound(10, security_param=lam) \n",
   "                for lam in lambdas]\n",
   "\n",
   "plt.figure(figsize=(12, 5))\n",
   "\n",
   "plt.subplot(1, 2, 1)\n",
   "plt.loglog(lambdas, bounds_linear, 'b-', label='H(C) = Θ(λ)', linewidth=2)\n",
   "plt.loglog(lambdas, bounds_log, 'g-', label='H(C) = Θ(log λ)', linewidth=2)\n",
   "plt.loglog(lambdas, bounds_const, 'r-', label='H(C) = O(1)', linewidth=2)\n",
   "plt.xlabel('Security Parameter λ', fontsize=12)\n",
   "plt.ylabel('CRO Bound', fontsize=12)\n",
   "plt.title('Asymptotic Behavior of CRO Bound', fontsize=14)\n",
   "plt.legend()\n",
   "plt.grid(True, alpha=0.3)\n",
   "\n",
   "# Probability of achieving balanced CRO\n",
   "plt.subplot(1, 2, 2)\n",
   "prob_balanced = [min(1, bound * 8) for bound in bounds_linear]  # Heuristic\n",
   "plt.semilogx(lambdas, prob_balanced, 'b-', linewidth=2)\n",
   "plt.xlabel('Security Parameter λ', fontsize=12)\n",
