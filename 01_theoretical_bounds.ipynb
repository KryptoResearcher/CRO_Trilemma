{
 "cells": [
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "# CRO Trilemma - Theoretical Bounds Exploration\n",
    "\n",
    "This notebook explores the theoretical bounds of the Confidentiality-Reliability-Opposability (CRO) Trilemma.\n",
    "\n",
    "## Key Results\n",
    "- Derive the fundamental impossibility bound\n",
    "- Visualize the achievable region in CRO space\n",
    "- Analyze trade-offs between dimensions\n",
    "- Compare information-theoretic vs computational bounds"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 1,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Setup and imports\n",
    "import sys\n",
    "import os\n",
    "sys.path.append('..')\n",
    "\n",
    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "from mpl_toolkits.mplot3d import Axes3D\n",
    "import pandas as pd\n",
    "import seaborn as sns\n",
    "from scipy import optimize\n",
    "from IPython.display import display, Markdown, Latex\n",
    "import warnings\n",
    "warnings.filterwarnings('ignore')\n",
    "\n",
    "# Import our modules\n",
    "from src.core.metrics import (\n",
    "    CROMetrics, \n",
    "    ProtocolMetrics,\n",
    "    ContextualEntropy,\n",
    "    QuantumInterpretability,\n",
    "    calculate_trilemma_bound\n",
    ")\n",
    "\n",
    "# Set plotting style\n",
    "plt.style.use('seaborn-v0_8-darkgrid')\n",
    "sns.set_palette(\"husl\")\n",
    "\n",
    "print(\"✓ Environment setup complete\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 1. The Fundamental CRO Bound\n",
    "\n",
    "The CRO trilemma states that for any protocol $\\mathcal{P}$:\n",
    "\n",
    "$$\\mathrm{Priv}(\\mathcal{P}) \\cdot \\mathrm{Rel}(\\mathcal{P}) \\cdot \\frac{H_{\\mathsf{Opp}}(\\mathcal{P}, \\mathcal{C})}{\\log |\\mathcal{V}_{\\mathcal{J}}|} \\leq \\frac{1}{2^{H(\\mathcal{C})}} + \\eta_q(\\mathcal{C}) + \\mathsf{negl}(\\lambda)$$"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 2,
   "metadata": {},
   "outputs": [],
   "source": [
    "def theoretical_bound(context_entropy, quantum_loss=0.01, security_param=128):\n",
    "    \"\"\"\n",
    "    Calculate the theoretical CRO bound\n",
    "    \"\"\"\n",
    "    negligible = 2**(-security_param)\n",
    "    bound = 1/(2**context_entropy) + quantum_loss + negligible\n",
    "    return bound\n",
    "\n",
    "# Explore how bound changes with context complexity\n",
    "context_entropies = np.linspace(1, 20, 100)\n",
    "bounds = [theoretical_bound(h_c) for h_c in context_entropies]\n",
    "\n",
    "plt.figure(figsize=(10, 6))\n",
    "plt.semilogy(context_entropies, bounds, 'b-', linewidth=2, label='Theoretical Bound')\n",
    "plt.axhline(y=0.5, color='r', linestyle='--', label='Γ_CRO = 0.5 threshold')\n",
    "plt.xlabel('Context Entropy H(C) (bits)', fontsize=12)\n",
    "plt.ylabel('CRO Bound', fontsize=12)\n",
    "plt.title('CRO Trilemma Bound vs Context Complexity', fontsize=14)\n",
    "plt.legend()\n",
    "plt.grid(True, alpha=0.3)\n",
    "plt.tight_layout()\n",
    "plt.show()\n",
    "\n",
    "print(f\"At H(C) = 10 bits: Bound = {theoretical_bound(10):.6f}\")\n",
    "print(f\"At H(C) = 128 bits: Bound = {theoretical_bound(128):.2e}\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 2. Information-Theoretic Analysis\n",
    "\n",
    "Let's analyze the information flow through the protocol and understand why the trilemma is fundamental."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 3,
   "metadata": {},
   "outputs": [],
   "source": [
    "class InformationFlow:\n",
    "    \"\"\"Analyze information flow in CRO protocols\"\"\"\n",
    "    \n",
    "    def __init__(self, input_entropy, proof_size, output_entropy):\n",
    "        self.H_X = input_entropy  # Private input entropy\n",
    "        self.H_Sigma = proof_size * 8  # Proof entropy (bits)\n",
    "        self.H_V = output_entropy  # Interpretation entropy\n",
    "        \n",
    "    def data_processing_inequality(self):\n",
    "        \"\"\"Apply data processing inequality: I(X;V) ≤ I(X;Σ) ≤ H(X)\"\"\"\n",
    "        return {\n",
    "            'max_mutual_info': min(self.H_X, self.H_Sigma),\n",
    "            'min_loss': max(0, self.H_X - self.H_Sigma),\n",
    "            'interpretation_loss': max(0, self.H_Sigma - self.H_V)\n",
    "        }\n",
    "    \n",
    "    def calculate_bottleneck(self, confidentiality, reliability):\n",
    "        \"\"\"Calculate information bottleneck\"\"\"\n",
    "        # Information preserved after privacy\n",
    "        after_privacy = self.H_X * (1 - confidentiality)\n",
    "        \n",
    "        # Information required for reliability\n",
    "        reliability_cost = self.H_Sigma * reliability\n",
    "        \n",
    "        # Remaining for opposability\n",
    "        remaining = max(0, self.H_Sigma - reliability_cost - after_privacy)\n",
    "        \n",
    "        return {\n",
    "            'after_privacy': after_privacy,\n",
    "            'reliability_cost': reliability_cost,\n",
    "            'opposability_budget': remaining\n",
    "        }\n",
    "\n",
    "# Analyze different protocols\n",
    "protocols_info = {\n",
    "    'Groth16': InformationFlow(256, 192, 1),  # ZK-SNARK\n",
    "    'Dilithium': InformationFlow(256, 2420, 40),  # Lattice\n",
    "    'ECDSA': InformationFlow(256, 64, 120),  # Classical\n",
    "}\n",
    "\n",
    "results_df = pd.DataFrame()\n",
    "for name, protocol in protocols_info.items():\n",
    "    dpi = protocol.data_processing_inequality()\n",
    "    bottleneck = protocol.calculate_bottleneck(0.9, 0.99)\n",
    "    \n",
    "    results_df = pd.concat([results_df, pd.DataFrame({\n",
    "        'Protocol': [name],\n",
    "        'Input_Entropy': [protocol.H_X],\n",
    "        'Proof_Size_Bits': [protocol.H_Sigma],\n",
    "        'Interpretation_Bits': [protocol.H_V],\n",
    "        'Max_Mutual_Info': [dpi['max_mutual_info']],\n",
    "        'Opposability_Budget': [bottleneck['opposability_budget']]\n",
    "    })], ignore_index=True)\n",
    "\n",
    "display(results_df)\n",
    "\n",
    "# Visualize information flow\n",
    "fig, (ax1, ax2) = plt.subplots(1, 2, figsize=(14, 5))\n",
    "\n",
    "# Information preservation\n",
    "protocols = results_df['Protocol'].values\n",
    "x_pos = np.arange(len(protocols))\n",
    "ax1.bar(x_pos, results_df['Input_Entropy'], alpha=0.7, label='Input')\n",
    "ax1.bar(x_pos, results_df['Proof_Size_Bits'], alpha=0.7, label='Proof')\n",
    "ax1.bar(x_pos, results_df['Interpretation_Bits'], alpha=0.7, label='Interpretation')\n",
    "ax1.set_xticks(x_pos)\n",
    "ax1.set_xticklabels(protocols)\n",
    "ax1.set_ylabel('Entropy (bits)')\n",
    "ax1.set_title('Information Flow Through Protocols')\n",
    "ax1.legend()\n",
    "ax1.set_yscale('log')\n",
    "\n",
    "# Opposability budget\n",
    "ax2.bar(x_pos, results_df['Opposability_Budget'])\n",
    "ax2.set_xticks(x_pos)\n",
    "ax2.set_xticklabels(protocols)\n",
    "ax2.set_ylabel('Remaining Bits for Opposability')\n",
    "ax2.set_title('Opposability Budget After C+R Constraints')\n",
    "ax2.axhline(y=0, color='r', linestyle='--', alpha=0.5)\n",
    "\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 3. Achievable Region in CRO Space\n",
    "\n",
    "Visualize the 3D region where protocols can exist without violating the trilemma."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 4,
   "metadata": {},
   "outputs": [],
   "source": [
    "def plot_achievable_region(context_entropy=10, quantum_loss=0.01):\n",
    "    \"\"\"Plot the achievable region in CRO space\"\"\"\n",
    "    \n",
    "    # Create mesh grid\n",
    "    priv_range = np.linspace(0, 1, 50)\n",
    "    rel_range = np.linspace(0, 1, 50)\n",
    "    Priv, Rel = np.meshgrid(priv_range, rel_range)\n",
    "    \n",
    "    # Calculate maximum opposability for each (Priv, Rel) pair\n",
    "    bound = theoretical_bound(context_entropy, quantum_loss)\n",
    "    \n",
    "    # Avoid division by zero\n",
    "    with np.errstate(divide='ignore', invalid='ignore'):\n",
    "        Opp_max = np.where((Priv * Rel) > 0, \n",
    "                          bound / (Priv * Rel),\n",
    "                          1.0)\n",
    "    Opp_max = np.minimum(Opp_max, 1.0)  # Cap at 1\n",
    "    \n",
    "    # Create 3D plot\n",
    "    fig = plt.figure(figsize=(12, 9))\n",
    "    ax = fig.add_subplot(111, projection='3d')\n",
    "    \n",
    "    # Plot surface\n",
    "    surf = ax.plot_surface(Priv, Rel, Opp_max, \n",
    "                          cmap='viridis', alpha=0.7,\n",
    "                          edgecolor='none')\n",
    "    \n",
    "    # Add example protocols\n",
    "    protocols = [\n",
    "        ('Groth16', 0.999, 0.997, 0.001, 'red'),\n",
    "        ('Dilithium', 0.823, 0.999, 0.156, 'blue'),\n",
    "        ('ECDSA', 0.001, 0.995, 0.92, 'green'),\n",
    "    ]\n",
    "    \n",
    "    for name, priv, rel, opp, color in protocols:\n",
    "        ax.scatter([priv], [rel], [opp], \n",
    "                  color=color, s=100, label=name,\n",
    "                  edgecolors='black', linewidth=2)\n",
    "    \n",
    "    # Labels and formatting\n",
    "    ax.set_xlabel('Confidentiality', labelpad=10)\n",
    "    ax.set_ylabel('Reliability', labelpad=10)\n",
    "    ax.set_zlabel('Opposability', labelpad=10)\n",
    "    ax.set_title(f'CRO Achievable Region (H(C)={context_entropy} bits)', pad=20)\n",
    "    \n",
    "    # Add colorbar\n",
    "    fig.colorbar(surf, ax=ax, shrink=0.5, aspect=5)\n",
    "    \n",
    "    ax.legend(loc='upper left')\n",
    "    ax.view_init(elev=20, azim=45)\n",
    "    \n",
    "    plt.tight_layout()\n",
    "    plt.show()\n",
    "    \n",
    "    return fig\n",
    "\n",
    "# Plot for different context complexities\n",
    "for h_c in [5, 10, 15]:\n",
    "    print(f\"\\n--- Context Entropy: {h_c} bits ---\")\n",
    "    fig = plot_achievable_region(h_c)\n",
    "    print(f\"Maximum achievable product: {theoretical_bound(h_c):.6f}\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 4. Trade-off Analysis\n",
    "\n",
    "Analyze the pairwise trade-offs between CRO dimensions."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 5,
   "metadata": {},
   "outputs": [],
   "source": [
    "def analyze_tradeoffs(fixed_dim='reliability', fixed_value=0.99, context_entropy=10):\n",
    "    \"\"\"Analyze trade-offs when one dimension is fixed\"\"\"\n",
    "    \n",
    "    bound = theoretical_bound(context_entropy)\n",
    "    \n",
    "    if fixed_dim == 'reliability':\n",
    "        priv_range = np.linspace(0.001, 1, 100)\n",
    "        opp_max = bound / (priv_range * fixed_value)\n",
    "        \n",
    "        plt.figure(figsize=(10, 6))\n",
    "        plt.plot(priv_range, opp_max, 'b-', linewidth=2)\n",
    "        plt.fill_between(priv_range, 0, opp_max, alpha=0.3)\n",
    "        plt.xlabel('Confidentiality', fontsize=12)\n",
    "        plt.ylabel('Max Opposability', fontsize=12)\n",
    "        plt.title(f'Privacy-Opposability Trade-off (Reliability={fixed_value})', fontsize=14)\n",
    "        \n",
    "    elif fixed_dim == 'confidentiality':\n",
    "        rel_range = np.linspace(0.001, 1, 100)\n",
    "        opp_max = bound / (fixed_value * rel_range)\n",
    "        \n",
    "        plt.figure(figsize=(10, 6))\n",
    "        plt.plot(rel_range, opp_max, 'g-', linewidth=2)\n",
    "        plt.fill_between(rel_range, 0, opp_max, alpha=0.3, color='green')\n",
    "        plt.xlabel('Reliability', fontsize=12)\n",
    "        plt.ylabel('Max Opposability', fontsize=12)\n",
    "        plt.title(f'Reliability-Opposability Trade-off (Confidentiality={fixed_value})', fontsize=14)\n",
    "        \n",
    "    elif fixed_dim == 'opposability':\n",
    "        priv_range = np.linspace(0.001, 1, 100)\n",
    "        rel_max = bound / (priv_range * fixed_value)\n",
    "        rel_max = np.minimum(rel_max, 1)  # Cap at 1\n",
    "        \n",
    "        plt.figure(figsize=(10, 6))\n",
    "        plt.plot(priv_range, rel_max, 'r-', linewidth=2)\n",
    "        plt.fill_between(priv_range, 0, rel_max, alpha=0.3, color='red')\n",
    "        plt.xlabel('Confidentiality', fontsize=12)\n",
    "        plt.ylabel('Max Reliability', fontsize=12)\n",
    "        plt.title(f'Privacy-Reliability Trade-off (Opposability={fixed_value})', fontsize=14)\n",
    "    \n",
    "    plt.grid(True, alpha=0.3)\n",
    "    plt.xlim([0, 1])\n",
    "    plt.ylim([0, max(plt.ylim()[1], 1.1)])\n",
    "    plt.tight_layout()\n",
    "    plt.show()\n",
    "\n",
    "# Analyze different trade-offs\n",
    "print(\"Trade-off Analysis:\")\n",
    "print(\"=\"*50)\n",
    "\n",
    "analyze_tradeoffs('reliability', 0.99, 10)\n",
    "analyze_tradeoffs('confidentiality', 0.9, 10)\n",
    "analyze_tradeoffs('opposability', 0.1, 10)"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 5. Quantum Effects on the Bound\n",
    "\n",
    "Analyze how quantum interpretability loss affects the achievable region."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 6,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Initialize quantum analysis\n",
    "qi = QuantumInterpretability()\n",
    "\n",
    "# Compare different quantum channels\n",
    "channels = ['depolarizing', 'amplitude_damping', 'phase_damping']\n",
