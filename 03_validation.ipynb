{
 "cells": [
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "# CRO Trilemma - Validation and Verification\n",
    "\n",
    "This notebook validates the theoretical predictions against empirical measurements and verifies the CRO trilemma.\n",
    "\n",
    "## Objectives\n",
    "- Validate theoretical bounds\n",
    "- Check measurement consistency\n",
    "- Verify trilemma violations\n",
    "- Test edge cases\n",
    "- Generate validation report"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 1,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Setup\n",
    "import sys\n",
    "import os\n",
    "sys.path.append('..')\n",
    "\n",
    "import numpy as np\n",
    "import pandas as pd\n",
    "import matplotlib.pyplot as plt\n",
    "import seaborn as sns\n",
    "from scipy import stats\n",
    "from IPython.display import display, Markdown\n",
    "import warnings\n",
    "warnings.filterwarnings('ignore')\n",
    "\n",
    "# Import validation modules\n",
    "from src.analysis.validation import ValidationSuite\n",
    "from src.analysis.statistical_analysis import StatisticalAnalyzer\n",
    "from src.core.metrics import calculate_trilemma_bound, CROMetrics\n",
    "from src.utils.helpers import load_data, calculate_statistics\n",
    "\n",
    "# Set style\n",
    "plt.style.use('seaborn-v0_8-darkgrid')\n",
    "sns.set_context(\"notebook\")\n",
    "\n",
    "print(\"✓ Validation environment ready\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 1. Load Measurement Data\n",
    "\n",
    "Load the empirical measurements from previous experiments."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 2,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Load empirical data\n",
    "try:\n",
    "    measurements_df = load_data('../data/results/empirical_measurements.csv')\n",
    "    detailed_results = load_data('../data/results/detailed_measurements.json')\n",
    "    print(f\"✓ Loaded {len(measurements_df)} measurements\")\n",
    "except FileNotFoundError:\n",
    "    print(\"⚠ Creating synthetic data for demonstration\")\n",
    "    # Create synthetic data if files don't exist\n",
    "    protocols = ['groth16', 'dilithium', 'sphincs', 'ecdsa']\n",
    "    contexts = ['gdpr', 'hipaa', 'financial', 'criminal']\n",
    "    \n",
    "    data = []\n",
    "    for protocol in protocols:\n",
    "        for context in contexts:\n",
    "            if protocol == 'groth16':\n",
    "                priv, rel, opp = 0.999, 0.997, 0.5\n",
    "            elif protocol == 'dilithium':\n",
    "                priv, rel, opp = 0.823, 0.999, 20.0\n",
    "            elif protocol == 'sphincs':\n",
    "                priv, rel, opp = 0.687, 0.999, 30.0\n",
    "            else:  # ecdsa\n",
    "                priv, rel, opp = 0.001, 0.995, 118.0\n",
    "            \n",
    "            # Add noise\n",
    "            priv += np.random.normal(0, 0.01)\n",
    "            rel += np.random.normal(0, 0.001)\n",
    "            opp += np.random.normal(0, 2)\n",
    "            \n",
    "            data.append({\n",
    "                'protocol': protocol,\n",
    "                'context': context,\n",
    "                'confidentiality': np.clip(priv, 0, 1),\n",
    "                'reliability': np.clip(rel, 0, 1),\n",
    "                'opposability': max(0, opp),\n",
    "                'opp_normalized': max(0, opp) / 128,\n",
    "                'gamma_cro': 1 - min(priv, rel, opp/128)\n",
    "            })\n",
    "    \n",
    "    measurements_df = pd.DataFrame(data)\n",
    "\n",
    "# Display summary\n",
    "print(\"\\nData Summary:\")\n",
    "print(\"=\"*50)\n",
    "print(f\"Protocols: {measurements_df['protocol'].unique().tolist()}\")\n",
    "print(f\"Contexts: {measurements_df['context'].unique().tolist()}\")\n",
    "print(f\"\\nMeasurement Statistics:\")\n",
    "display(measurements_df.describe().round(4))"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 2. Validate Theoretical Bounds\n",
    "\n",
    "Check if empirical measurements respect the theoretical CRO bound."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 3,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Initialize validator\n",
    "validator = ValidationSuite()\n",
    "analyzer = StatisticalAnalyzer()\n",
    "\n",
    "# Check each measurement against theoretical bound\n",
    "validation_results = []\n",
    "\n",
    "for _, row in measurements_df.iterrows():\n",
    "    # Estimate context entropy (simplified)\n",
    "    context_entropies = {'gdpr': 11, 'hipaa': 10, 'financial': 12, 'criminal': 9}\n",
    "    h_c = context_entropies.get(row['context'], 10)\n",
    "    \n",
    "    # Estimate quantum loss\n",
    "    eta_q = 0.01 if row['protocol'] != 'groth16' else 0.001\n",
    "    \n",
    "    # Validate trilemma bound\n",
    "    valid = validator.validate_trilemma_bound(\n",
    "        row['confidentiality'],\n",
    "        row['reliability'],\n",
    "        row['opp_normalized'],\n",
    "        h_c,\n",
    "        eta_q\n",
    "    )\n",
    "    \n",
    "    validation_results.append({\n",
    "        'protocol': row['protocol'],\n",
    "        'context': row['context'],\n",
    "        'valid': valid,\n",
    "        'product': row['confidentiality'] * row['reliability'] * row['opp_normalized'],\n",
    "        'bound': 1/(2**h_c) + eta_q + 2**(-128)\n",
    "    })\n",
    "\n",
    "validation_df = pd.DataFrame(validation_results)\n",
    "\n",
    "# Summarize violations\n",
    "print(\"\\nTheoretical Bound Validation:\")\n",
    "print(\"=\"*50)\n",
    "print(f\"Total measurements: {len(validation_df)}\")\n",
    "print(f\"Valid: {validation_df['valid'].sum()} ({validation_df['valid'].mean()*100:.1f}%)\")\n",
    "print(f\"Violations: {(~validation_df['valid']).sum()} ({(~validation_df['valid']).mean()*100:.1f}%)\")\n",
    "\n",
    "if len(validator.violations) > 0:\n",
    "    print(\"\\nViolation Details:\")\n",
    "    for v in validator.violations[:5]:  # Show first 5\n",
    "        print(f\"  Excess: {v['excess']:.6f} (actual={v['actual']:.6f}, bound={v['bound']:.6f})\")\n",
    "\n",
    "# Visualize bound compliance\n",
    "fig, (ax1, ax2) = plt.subplots(1, 2, figsize=(14, 6))\n",
    "\n",
    "# Actual vs Bound scatter\n",
    "ax1.scatter(validation_df['bound'], validation_df['product'], \n",
    "           alpha=0.6, c=validation_df['valid'].map({True: 'green', False: 'red'}))\n",
    "ax1.plot([0, max(validation_df['bound'])], [0, max(validation_df['bound'])], \n",
    "        'k--', label='y=x (bound)')\n",
    "ax1.set_xlabel('Theoretical Bound')\n",
    "ax1.set_ylabel('Actual Product (Priv·Rel·Opp)')\n",
    "ax1.set_title('Theoretical Bound Compliance')\n",
    "ax1.legend()\n",
    "ax1.grid(True, alpha=0.3)\n",
    "\n",
    "# Violation distribution\n",
    "violations_by_protocol = validation_df[~validation_df['valid']].groupby('protocol').size()\n",
    "if len(violations_by_protocol) > 0:\n",
    "    ax2.bar(range(len(violations_by_protocol)), violations_by_protocol.values)\n",
    "    ax2.set_xticks(range(len(violations_by_protocol)))\n",
    "    ax2.set_xticklabels(violations_by_protocol.index)\n",
    "    ax2.set_ylabel('Number of Violations')\n",
    "    ax2.set_title('Violations by Protocol')\n",
    "else:\n",
    "    ax2.text(0.5, 0.5, '✓ No Violations', ha='center', va='center', \n",
    "            fontsize=20, color='green', weight='bold')\n",
    "    ax2.set_title('Violation Check')\n",
    "    ax2.set_xticks([])\n",
    "\n",
    "ax2.grid(True, alpha=0.3)\n",
    "\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 3. Validate Metric Ranges and Consistency\n",
    "\n",
    "Check that all metrics are within valid ranges and consistent with protocol types."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 4,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Check metric ranges\n",
    "print(\"\\nMetric Range Validation:\")\n",
    "print(\"=\"*50)\n",
    "\n",
    "for _, row in measurements_df.iterrows():\n",
    "    metrics = {\n",
    "        'confidentiality': row['confidentiality'],\n",
    "        'reliability': row['reliability'],\n",
    "        'opposability': row['opposability']\n",
    "    }\n",
    "    validator.validate_metric_ranges(metrics)\n",
    "\n",
    "if validator.warnings:\n",
    "    print(\"⚠ Range warnings:\")\n",
    "    for warning in validator.warnings:\n",
    "        print(f\"  - {warning}\")\n",
    "else:\n",
    "    print(\"✓ All metrics within valid ranges\")\n",
    "\n",
    "# Check consistency\n",
    "consistency_result = validator.validate_consistency(measurements_df)\n",
    "\n",
    "print(\"\\nConsistency Check:\")\n",
    "print(\"=\"*50)\n",
    "if consistency_result['consistent']:\n",
    "    print(\"✓ All measurements consistent with protocol types\")\n",
    "else:\n",
    "    print(\"⚠ Consistency issues found:\")\n",
    "    for issue in consistency_result['issues']:\n",
    "        print(f\"  - {issue}\")\n",
    "\n",
    "# Visual consistency check\n",
    "fig, axes = plt.subplots(2, 2, figsize=(12, 10))\n",
    "\n",
    "# Protocol-specific patterns\n",
    "for idx, metric in enumerate(['confidentiality', 'reliability', \n",
    "                             'opposability', 'gamma_cro']):\n",
    "    ax = axes[idx // 2, idx % 2]\n",
    "    \n",
    "    # Box plot by protocol\n",
    "    measurements_df.boxplot(column=metric, by='protocol', ax=ax)\n",
    "    ax.set_title(f'{metric.capitalize()} by Protocol')\n",
    "    ax.set_xlabel('Protocol')\n",
    "    ax.set_ylabel(metric.capitalize())\n",
    "    ax.grid(True, alpha=0.3)\n",
    "\n",
    "plt.suptitle('Metric Consistency Across Protocols', fontsize=14)\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 4. Statistical Hypothesis Testing\n",
    "\n",
    "Test key hypotheses about the CRO trilemma."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 5,
   "metadata": {},
   "outputs": [],
   "source": [
    "print(\"\\nStatistical Hypothesis Testing:\")\n",
    "print(\"=\"*50)\n",
    "\n",
    "# Hypothesis 1: No protocol achieves Γ_CRO < 0.5\n",
    "gamma_values = measurements_df['gamma_cro'].values\n",
    "t_stat, p_value = stats.ttest_1samp(gamma_values, 0.5, alternative='greater')\n",
    "\n",
    "print(\"\\nH1: All protocols have Γ_CRO > 0.5\")\n",
    "print(f\"  Mean Γ_CRO: {np.mean(gamma_values):.4f}\")\n",
    "print(f\"  t-statistic: {t_stat:.4f}\")\n",
    "print(f\"  p-value: {p_value:.6f}\")\n",
    "print(f\"  Result: {'✓ Hypothesis supported' if p_value < 0.05 else '✗ Hypothesis not supported'}\")\n",
    "\n",
    "# Hypothesis 2: ZK protocols have lower opposability\n",
    "zk_opp = measurements_df[measurements_df['protocol'] == 'groth16']['opposability'].values\n",
    "non_zk_opp = measurements_df[measurements_df['protocol'] != 'groth16']['opposability'].values\n",
    "t_stat, p_value = stats.ttest_ind(zk_opp, non_zk_opp, alternative='less')\n",
    "\n",
    "print(\"\\nH2: ZK protocols have significantly lower opposability\")\n",
    "print(f\"  ZK mean: {np.mean(zk_opp):.2f} bits\")\n",
    "print(f\"  Non-ZK mean: {np.mean(non_zk_opp):.2f} bits\")\n",
    "print(f\"  t-statistic: {t_stat:.4f}\")\n",
    "print(f\"  p-value: {p_value:.6f}\")\n",
    "print(f\"  Result: {'✓ Hypothesis supported' if p_value < 0.05 else '✗ Hypothesis not supported'}\")\n",
    "\n",
    "# Hypothesis 3: Context affects opposability\n",
    "f_stat, p_value = stats.f_oneway(\n",
    "    *[measurements_df[measurements_df['context'] == c]['opposability'].values \n",
    "      for c in measurements_df['context'].unique()]\n",
    ")\n",
    "\n",
    "print(\"\\nH3: Context significantly affects opposability\")\n",
    "print(f\"  F-statistic: {f_stat:.4f}\")\n",
    "cell_type": "code",
  "execution_count": 5,
  "metadata": {},
  "outputs": [],
  "source": [
   "print(f\"  p-value: {p_value:.6f}\")\n",
   "print(f\"  Result: {'✓ Hypothesis supported' if p_value < 0.05 else '✗ Hypothesis not supported'}\")\n",
   "\n",
   "# Visualize hypothesis tests\n",
   "fig, axes = plt.subplots(1, 3, figsize=(15, 5))\n",
   "\n",
   "# H1: Gamma distribution\n",
   "ax1 = axes[0]\n",
   "ax1.hist(gamma_values, bins=20, alpha=0.7, edgecolor='black')\n",
   "ax1.axvline(x=0.5, color='r', linestyle='--', label='Threshold (0.5)')\n",
   "ax1.axvline(x=np.mean(gamma_values), color='g', linestyle='-', label=f'Mean ({np.mean(gamma_values):.3f})')\n",
   "ax1.set_xlabel('Γ_CRO')\n",
   "ax1.set_ylabel('Frequency')\n",
   "ax1.set_title('H1: Γ_CRO Distribution')\n",
   "ax1.legend()\n",
   "ax1.grid(True, alpha=0.3)\n",
   "\n",
   "# H2: ZK vs Non-ZK opposability\n",
   "ax2 = axes[1]\n",
   "data_to_plot = [zk_opp, non_zk_opp]\n",
   "bp = ax2.boxplot(data_to_plot, labels=['ZK (Groth16)', 'Non-ZK'], patch_artist=True)\n",
   "bp['boxes'][0].set_facecolor('red')\n",
   "bp['boxes'][1].set_facecolor('blue')\n",
   "ax2.set_ylabel('Opposability (bits)')\n",
   "ax2.set_title('H2: ZK vs Non-ZK Opposability')\n",
   "ax2.grid(True, alpha=0.3)\n",
   "\n",
   "# H3: Context effect\n",
   "ax3 = axes[2]\n",
   "context_data = [measurements_df[measurements_df['context'] == c]['opposability'].values \n",
   "                for c in measurements_df['context'].unique()]\n",
   "bp = ax3.boxplot(context_data, labels=measurements_df['context'].unique(), patch_artist=True)\n",
   "for patch, color in zip(bp['boxes'], sns.color_palette('husl', 4)):\n",
   "    patch.set_facecolor(color)\n",
   "ax3.set_xlabel('Context')\n",
   "ax3.set_ylabel('Opposability (bits)')\n",
   "ax3.set_title('H3: Context Effect on Opposability')\n",
   "ax3.grid(True, alpha=0.3)\n",
   "\n",
   "plt.suptitle('Statistical Hypothesis Tests', fontsize=14, y=1.02)\n",
   "plt.tight_layout()\n",
   "plt.show()"
  ]
 },
 {
  "cell_type": "markdown",
  "metadata": {},
  "source": [
   "## 5. Edge Case Testing\n",
   "\n",
   "Test extreme parameter combinations to verify the trilemma holds."
  ]
 },
 {
  "cell_type": "code",
  "execution_count": 6,
  "metadata": {},
  "outputs": [],
  "source": [
   "print(\"\\nEdge Case Testing:\")\n",
   "print(\"=\"*50)\n",
   "\n",
   "# Define edge cases\n",
   "edge_cases = [\n",
   "    {'name': 'Perfect Privacy', 'priv': 1.0, 'rel': 0.5, 'opp': 0.001},\n",
   "    {'name': 'Perfect Reliability', 'priv': 0.5, 'rel': 1.0, 'opp': 0.001},\n",
   "    {'name': 'Perfect Opposability', 'priv': 0.001, 'rel': 0.5, 'opp': 128.0},\n",
   "    {'name': 'All High', 'priv': 0.99, 'rel': 0.99, 'opp': 127.0},\n",
   "    {'name': 'All Low', 'priv': 0.01, 'rel': 0.01, 'opp': 1.0},\n",
   "    {'name': 'Balanced', 'priv': 0.577, 'rel': 0.577, 'opp': 73.856},  # cube root of bound\n",
   "]\n",
   "\n",
   "edge_results = []\n",
   "h_c = 10  # Fixed context entropy\n",
   "eta_q = 0.01  # Fixed quantum loss\n",
   "\n",
   "for case in edge_cases:\n",
   "    # Create metrics\n",
   "    metrics = CROMetrics(\n",
   "        confidentiality=case['priv'],\n",
   "        reliability=case['rel'],\n",
   "        opposability=case['opp'],\n",
   "        context_entropy=h_c,\n",
   "        quantum_loss=eta_q\n",
   "    )\n",
   "    \n",
   "    # Check bound\n",
   "    bound, actual, satisfied = calculate_trilemma_bound(metrics)\n",
   "    \n",
   "    edge_results.append({\n",
   "        'Case': case['name'],\n",
   "        'Priv': case['priv'],\n",
   "        'Rel': case['rel'],\n",
   "        'Opp': case['opp'],\n",
   "        'Opp_Norm': case['opp']/128,\n",
   "        'Product': actual,\n",
   "        'Bound': bound,\n",
   "        'Valid': satisfied,\n",
   "        'Gamma_CRO': metrics.gamma_cro\n",
   "    })\n",
   "\n",
   "edge_df = pd.DataFrame(edge_results)\n",
   "display(edge_df.round(6))\n",
   "\n",
   "# Visualize edge cases in 3D\n",
   "from mpl_toolkits.mplot3d import Axes3D\n",
   "\n",
   "fig = plt.figure(figsize=(10, 8))\n",
   "ax = fig.add_subplot(111, projection='3d')\n",
   "\n",
   "# Plot edge cases\n",
   "colors = ['green' if v else 'red' for v in edge_df['Valid']]\n",
   "ax.scatter(edge_df['Priv'], edge_df['Rel'], edge_df['Opp_Norm'], \n",
   "          c=colors, s=100, alpha=0.8, edgecolors='black', linewidth=2)\n",
   "\n",
   "# Add labels\n",
   "for idx, row in edge_df.iterrows():\n",
   "    ax.text(row['Priv'], row['Rel'], row['Opp_Norm'], \n",
   "           row['Case'], fontsize=9)\n",
   "\n",
   "ax.set_xlabel('Confidentiality')\n",
   "ax.set_ylabel('Reliability')\n",
   "ax.set_zlabel('Opposability (Normalized)')\n",
   "ax.set_title('Edge Cases in CRO Space')\n",
   "ax.view_init(elev=20, azim=45)\n",
   "\n",
   "plt.tight_layout()\n",
   "plt.show()\n",
   "\n",
   "print(f\"\\nEdge cases respecting bound: {edge_df['Valid'].sum()}/{len(edge_df)}\")\n",
   "print(f\"Minimum Γ_CRO achieved: {edge_df['Gamma_CRO'].min():.4f}\")"
  ]
 },
 {
  "cell_type": "markdown",
  "metadata": {},
  "source": [
   "## 6. Cross-Validation with Theory\n",
   "\n",
   "Compare empirical results with theoretical predictions."
  ]
 },
 {
  "cell_type": "code",
  "execution_count": 7,
  "metadata": {},
  "outputs": [],
  "source": [
   "print(\"\\nCross-Validation with Theory:\")\n",
   "print(\"=\"*50)\n",
   "\n",
   "# Theoretical predictions for each protocol\n",
   "theoretical_predictions = {\n",
   "    'groth16': {'priv': 0.999, 'rel': 0.997, 'opp': 0.5, 'gamma': 0.999},\n",
   "    'dilithium': {'priv': 0.823, 'rel': 0.999, 'opp': 20.0, 'gamma': 0.844},\n",
   "    'sphincs': {'priv': 0.687, 'rel': 0.999, 'opp': 30.0, 'gamma': 0.766},\n",
   "    'ecdsa': {'priv': 0.001, 'rel': 0.995, 'opp': 118.0, 'gamma': 0.999}\n",
   "}\n",
   "\n",
   "# Compare with empirical\n",
   "comparison_results = []\n",
   "\n",
   "for protocol in theoretical_predictions:\n",
   "    theory = theoretical_predictions[protocol]\n",
   "    empirical = measurements_df[measurements_df['protocol'] == protocol]\n",
   "    \n",
   "    comparison_results.append({\n",
   "        'Protocol': protocol,\n",
   "        'Metric': 'Confidentiality',\n",
   "        'Theoretical': theory['priv'],\n",
   "        'Empirical_Mean': empirical['confidentiality'].mean(),\n",
   "        'Empirical_Std': empirical['confidentiality'].std(),\n",
   "        'Relative_Error': abs(theory['priv'] - empirical['confidentiality'].mean()) / theory['priv']\n",
   "    })\n",
   "    \n",
   "    comparison_results.append({\n",
   "        'Protocol': protocol,\n",
   "        'Metric': 'Reliability',\n",
   "        'Theoretical': theory['rel'],\n",
   "        'Empirical_Mean': empirical['reliability'].mean(),\n",
   "        'Empirical_Std': empirical['reliability'].std(),\n",
   "        'Relative_Error': abs(theory['rel'] - empirical['reliability'].mean()) / theory['rel']\n",
   "    })\n",
   "    \n",
   "    comparison_results.append({\n",
   "        'Protocol': protocol,\n",
   "        'Metric': 'Opposability',\n",
   "        'Theoretical': theory['opp'],\n",
   "        'Empirical_Mean': empirical['opposability'].mean(),\n",
   "        'Empirical_Std': empirical['opposability'].std(),\n",
   "        'Relative_Error': abs(theory['opp'] - empirical['opposability'].mean()) / max(theory['opp'], 0.1)\n",
   "    })\n",
   "\n",
   "comparison_df = pd.DataFrame(comparison_results)\n",
   "\n",
   "# Display comparison by metric\n",
   "for metric in ['Confidentiality', 'Reliability', 'Opposability']:\n",
   "    print(f\"\\n{metric}:\")\n",
   "    metric_df = comparison_df[comparison_df['Metric'] == metric][[\n",
   "        'Protocol', 'Theoretical', 'Empirical_Mean', 'Empirical_Std', 'Relative_Error'\n",
   "    ]]\n",
   "    display(metric_df.round(4))\n",
   "\n",
   "# Visualize theory vs empirical\n",
   "fig, axes = plt.subplots(1, 3, figsize=(15, 5))\n",
   "\n",
   "for idx, metric in enumerate(['Confidentiality', 'Reliability', 'Opposability']):\n",
   "    ax = axes[idx]\n",
   "    \n",
   "    metric_data = comparison_df[comparison_df['Metric'] == metric]\n",
   "    \n",
   "    x_pos = np.arange(len(metric_data))\n",
   "    width = 0.35\n",
   "    \n",
   "    ax.bar(x_pos - width/2, metric_data['Theoretical'], width, \n",
   "          label='Theoretical', alpha=0.8, color='blue')\n",
   "    ax.bar(x_pos + width/2, metric_data['Empirical_Mean'], width,\n",
   "          yerr=metric_data['Empirical_Std'], capsize=5,\n",
   "          label='Empirical', alpha=0.8, color='orange')\n",
   "    \n",
   "    ax.set_xlabel('Protocol')\n",
   "    ax.set_ylabel(metric)\n",
   "    ax.set_title(f'{metric}: Theory vs Empirical')\n",
   "    ax.set_xticks(x_pos)\n",
   "    ax.set_xticklabels(metric_data['Protocol'], rotation=45)\n",
   "    ax.legend()\n",
   "    ax.grid(True, alpha=0.3)\n",
   "\n",
   "plt.suptitle('Theoretical Predictions vs Empirical Measurements', fontsize=14)\n",
   "plt.tight_layout()\n",
   "plt.show()\n",
   "\n",
   "# Calculate overall agreement\n",
   "mean_relative_error = comparison_df['Relative_Error'].mean()\n",
   "print(f\"\\nMean Relative Error: {mean_relative_error:.4f} ({mean_relative_error*100:.2f}%)\")\n",
   "print(f\"Agreement Level: {'Excellent' if mean_relative_error < 0.05 else 'Good' if mean_relative_error < 0.10 else 'Fair'}\")"
  ]
